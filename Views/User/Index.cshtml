@model IEnumerable<MedTrack_Projeto.Models.Usuario>

<h2>Usuários</h2>
<a asp-action="Create" class="btn btn-success mb-3">Novo Usuário</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Tipo</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Nome</td>
                <td>@user.Email</td>
                <td>@user.Telefone</td>
                <td>
                    @(user.TipoUsuario == 1 ? "Administrador" : user.TipoUsuario == 2 ? "Supervisor"
                                    : "Comum")
            </td>
            <td>@(user.AtivarUsuario ? "Sim" : "Não")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary btnsm">Editar</a>
                @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btnsm">Excluir</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
