@model MedTrack_Projeto.Models.Usuario

<h2>Editar Usuário</h2>
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Senha" class="form-label"></label>
        <input asp-for="Senha" type="password" class="form-control" />
        <span asp-validation-for="Senha" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmarSenha" class="form-label"></label>
        <input asp-for="ConfirmarSenha" type="password" class="form-control" />
        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <div class="form-check mb-3">
            <input asp-for="AtivarUsuario" class="form-check-input" />
            <label asp-for="AtivarUsuario" class="form-check-label"></label>
        </div>
        <div class="mb-3">
            <label asp-for="TipoUsuario" class="form-label"></label>
            <select asp-for="TipoUsuario" class="form-select">
                <option value="1" selected="@(Model.TipoUsuario == 1)">Administrador</option>
                <option value="2" selected="@(Model.TipoUsuario == 2)">Supervisor</option>
                <option value="3" selected="@(Model.TipoUsuario == 3)">Comum</option>
            </select>
        </div>
    }
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}