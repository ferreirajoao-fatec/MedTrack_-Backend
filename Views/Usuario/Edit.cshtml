@model MedTrack_Projeto.Models.Usuario

@{
    ViewData["Title"] = "Edit";
}


<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="text-center mb-4">Edit Usuario</h1>
                    <hr />

                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdUsuario" />

                        <div class="mb-3">
                            <label asp-for="NomeUsuario" class="form-label"></label>
                            <input asp-for="NomeUsuario" class="form-control text-center" />
                            <span asp-validation-for="NomeUsuario" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmailUsuario" class="form-label"></label>
                            <input asp-for="EmailUsuario" class="form-control text-center" />
                            <span asp-validation-for="EmailUsuario" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CpfUsuario" class="form-label"></label>
                            <input asp-for="CpfUsuario" class="form-control text-center" />
                            <span asp-validation-for="CpfUsuario" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SenhaUsuario" class="form-label"></label>
                            <input asp-for="SenhaUsuario" type="password" class="form-control text-center" />
                            <span asp-validation-for="SenhaUsuario" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarSenhaUsuario" class="form-label"></label>
                            <input asp-for="ConfirmarSenhaUsuario" type="password" class="form-control text-center" />
                            <span asp-validation-for="ConfirmarSenhaUsuario" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>