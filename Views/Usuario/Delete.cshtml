@model MedTrack_Projeto.Models.Usuario

@{
    ViewData["Title"] = "Delete";
}


<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />


<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h1 class="mb-4">Delete Usuario</h1>
                    <h5 class="text-danger mb-3">Are you sure you want to delete this?</h5>
                    <hr />

                    <dl class="row text-start">
                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeUsuario)</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EmailUsuario)</dd>

                        <dt class="col-sm-4">CPF</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CpfUsuario)</dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="IdUsuario" />
                        <div class="d-flex justify-content-center gap-2">
                            <input type="submit" value="Delete" class="btn btn-danger" />
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
