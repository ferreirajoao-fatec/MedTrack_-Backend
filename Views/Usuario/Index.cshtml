@model IEnumerable<MedTrack_Projeto.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}


<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />

<div class="container py-5">
    <h1 class="text-center mb-4">Usuarios</h1>

    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-success">Create New</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().NomeUsuario)</th>
                    <th>@Html.DisplayNameFor(model => model.First().EmailUsuario)</th>
                    <th>@Html.DisplayNameFor(model => model.First().CpfUsuario)</th>
                    <th>Operações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NomeUsuario)</td>
                        <td>@Html.DisplayFor(modelItem => item.EmailUsuario)</td>
                        <td>@Html.DisplayFor(modelItem => item.CpfUsuario)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-primary btn-sm me-1">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-info btn-sm me-1">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
