@model MedTrack_Projeto.Models.Usuario

@{
    ViewData["Title"] = "Details";
}


<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="text-center mb-4">Usuario Details</h1>
                    <hr />

                    <dl class="row text-start">
                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeUsuario)</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EmailUsuario)</dd>

                        <dt class="col-sm-4">CPF</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CpfUsuario)</dd>
                    </dl>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.IdUsuario" class="btn btn-primary">Edit</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
