@model MedTrack_Projeto.Models.DadosVitais

@{
ViewData["Title"] = "Delete - Dados Vitais";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />

<div class="container py-5">
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h1 class="mb-4">Delete Dados Vitais</h1>
                <h5 class="text-danger mb-3">Are you sure you want to delete this?</h5>
                <hr />

                <dl class="row text-start">
                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>

                    <dt class="col-sm-4">CPF</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CPF)</dd>

                    <dt class="col-sm-4">Data de Nascimento</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DataNascimento)</dd>

                    <dt class="col-sm-4">Sexo</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Sexo)</dd>

                    <dt class="col-sm-4">Altura</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Altura)</dd>

                    <dt class="col-sm-4">Peso</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Peso)</dd>

                    <dt class="col-sm-4">Tipo Sanguíneo</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.TipoSanguineo)</dd>

                    <dt class="col-sm-4">SUS</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.SUS)</dd>

                    <dt class="col-sm-4">Contato</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeContato)</dd>

                    <dt class="col-sm-4">Telefone Contato</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.TelefoneContato)</dd>

                    <dt class="col-sm-4">Relacionamento</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Relacionamento)</dd>

                    <dt class="col-sm-4">Medicamento</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Medicamento)</dd>

                    <dt class="col-sm-4">Dosagem</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Dosagem)</dd>

                    <dt class="col-sm-4">Frequência</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Frequencia)</dd>

                    <dt class="col-sm-4">Observações</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Observacoes)</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="IdUsuario" />
                    <div class="d-flex justify-content-center gap-2">
                        <input type="submit" value="Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
