@model IEnumerable<MedTrack_Projeto.Models.DadosVitais>

@{
    ViewData["Title"] = "Dados Vitais";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- CSS CRUD personalizado -->
<link rel="stylesheet" href="~/css/crud.css" />

<div class="container py-5">
    <h1 class="text-center mb-4">Dados Vitais</h1>

    <!-- Botão Criar Novo -->
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-success">Criar Novo Dados Vitais</a>
    </div>

    <h2 class="mb-3">Dados Pessoais e Médicos</h2>
    <div class="table-responsive mb-5">
        <table class="table table-striped table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Data de Nascimento</th>
                    <th>Sexo</th>
                    <th>Altura</th>
                    <th>Peso</th>
                    <th>Tipo Sanguíneo</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdUsuario</td>
                        <td>@item.Nome</td>
                        <td>@item.CPF</td>
                        <td>@item.DataNascimento?.ToString("dd/MM/yyyy")</td>
                        <td>@item.Sexo</td>
                        <td>@item.Altura</td>
                        <td>@item.Peso</td>
                        <td>@item.TipoSanguineo</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="mb-3">Informações de Emergência e Medicação</h2>
    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Contato de Emergência</th>
                    <th>Telefone</th>
                    <th>Relacionamento</th>
                    <th>Medicamento</th>
                    <th>Dosagem</th>
                    <th>Frequência</th>
                    <th>Observações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NomeContato</td>
                        <td>@item.TelefoneContato</td>
                        <td>@item.Relacionamento</td>
                        <td>@item.Medicamento</td>
                        <td>@item.Dosagem</td>
                        <td>@item.Frequencia</td>
                        <td>@item.Observacoes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
