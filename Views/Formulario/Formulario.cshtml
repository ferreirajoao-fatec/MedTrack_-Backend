@{
    ViewData["Title"] = "Formulário Medtrack";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Ícone -->
    <link rel="shortcut icon" href="~/imagens/logo-escuro.svg" type="image/x-icon" asp-append-version="true" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/formulario.css" asp-append-version="true" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body>
    <main>
        <section class="container-login">
            <div class="container-form">

                <!-- Botão modo escuro -->
                <a href="#" id="dark-mode-toggle" class="theme-toggle">
                    <i class="fa-solid fa-moon"></i>
                </a>

                <!-- Voltar para home -->
                <a class="seta" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>

                <h1>Preencha seu Formulário</h1>
                <p class="texto">Seu espaço para cuidar da saúde.</p>

                <form class="login-form" method="post" asp-controller="Formulario" asp-action="EnviarFormulario">

                    <!-- Dados pessoais -->
                    <h2>Dados Pessoais</h2>
                    <details>
                        <summary>Clique para adicionar os dados pessoais</summary>
                    <label class="label" for="nome">Nome Completo:</label>
                    <input type="text" id="nome" name="Nome" placeholder="Digite seu nome completo." />

                    <label class="label" for="cpf">CPF:</label>
                    <input type="text" id="cpf" name="CPF" placeholder="000.000.000-00" />

                    <label class="label" for="dataNascimento">Data de Nascimento:</label>
                    <input type="date" id="dataNascimento" name="DataNascimento" />

                    <label class="label" for="sexo">Sexo:</label>
                    <select id="sexo" name="Sexo">
                        <option value="" disabled selected>Selecione</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Outro">Outro</option>
                    </select>

                    <label class="label" for="altura">Altura:</label>
                    <input type="text" id="altura" name="Altura" placeholder="Ex: 1,75m" />

                    <label class="label" for="peso">Peso:</label>
                    <input type="text" id="peso" name="Peso" placeholder="Ex: 70kg" />

                    <label class="label" for="tipo-sanguineo">Tipo Sanguíneo:</label>
                    <select id="tipo-sanguineo" name="TipoSanguineo">
                        <option value="" disabled selected>Selecione</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>

                    <label class="label" for="sus">Cartão SUS:</label>
                    <input type="text" id="sus" name="SUS" placeholder="Digite o número do cartão SUS" />

                    </details>
                    <!-- Contato de emergência (expansível) -->
                    <h2>Contato de Emergência</h2>
                    <details>
                        <summary>Clique para adicionar contato de emergência</summary>

                        <div class="emergencia">
                            <label class="label" for="nomeContato">Nome:</label>
                            <input type="text" id="nomeContato" name="NomeContato" placeholder="Digite o nome do contato" />

                            <label class="label" for="telefoneContato">Telefone:</label>
                            <input type="tel" id="telefoneContato" name="TelefoneContato" placeholder="(00) 00000-0000" />

                            <label class="label" for="relacionamento">Relacionamento:</label>
                            <input type="text" id="relacionamento" name="Relacionamento" placeholder="Ex: Mãe, Primo, Tio..." />
                        </div>
                    </details>

                    <!-- Medicamentos -->
                    <h2>Medicamentos</h2>
                    <details>
                        <summary>Clique para adicionar as medicações usadas</summary>
                    <label class="label" for="medicamento">Nome do Medicamento:</label>
                    <input type="text" id="medicamento" name="Medicamento" placeholder="Digite o nome do medicamento." />

                    <label class="label" for="dosagem">Dosagem:</label>
                    <input type="text" id="dosagem" name="Dosagem" placeholder="Ex: 50mg" />

                    <label class="label" for="frequencia">Frequência:</label>
                    <input type="text" id="frequencia" name="Frequencia" placeholder="Ex: Uma vez ao dia" />
                    </details>

                    <!-- Observações -->
                    <h2>Observações</h2>
                    <textarea id="observacoes" name="Observacoes" rows="4" placeholder="Digite observações adicionais..."></textarea>

                    <!-- Botão Enviar -->
                    <input type="submit" value="Enviar" />
                </form>
            </div>

            <!-- VLibras -->
            <div vw class="enabled">
                <div vw-access-button class="active"></div>
                <div vw-plugin-wrapper>
                    <div class="vw-plugin-top-wrapper"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- Scripts -->
    <script src="~/js/modo-escuro.js" asp-append-version="true"></script>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>
</body>
</html>
