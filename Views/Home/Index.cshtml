<div class="container-fluid my-4 px-4">
<div class="emergency-header" role="region" aria-labelledby="emergency-title">

<div class="header-layout">
<!-- Coluna esquerda -->
<section>
<h1 id="emergency-title" class="title-header">Central de Emergências</h1>
<p class="lead-desc">Informações rápidas e práticas: contatos, primeiros socorros, kit e hospitais próximos.</p>

<div class="row">
<div class="col-12 col-md-6 mb-3">
<div class="emergency-card h-100">
<h3>Contatos de Emergência</h3>
<ul class="list-unstyled mb-0">
<li>SAMU - 192</li>
<li>Bombeiros - 193</li>
<li>Polícia - 190</li>
</ul>
</div>
</div>

<div class="col-12 col-md-6 mb-3">
<div class="emergency-card h-100">
<h3>Dicas de Primeiros Socorros</h3>
<ul class="list-unstyled mb-0">
<li>Parar hemorragias com compressão direta</li>
<li>Colocar vítima inconsciente de lado</li>
<li>Não mover vítimas com fraturas graves</li>
</ul>
</div>
</div>

<div class="col-12 col-md-6 mb-3">
<div class="emergency-card h-100">
<h3>Kit de Primeiros Socorros</h3>
<ul class="list-unstyled mb-0">
<li>Curativos</li>
<li>Gaze</li>
<li>Antisséptico</li>
<li>Esparadrapo</li>
<li>Tesoura</li>
</ul>
</div>
</div>

<div class="col-12 col-md-6 mb-3">
<div class="emergency-card h-100">
<h3>Hospitais Próximos</h3>
<ul class="list-unstyled mb-0">
<li>Hospital Central - Rua Principal, 123</li>
<li>Hospital São João - Av. Saúde, 456</li>
<li>Pronto Socorro Regional - Rua Emergência, 789</li>
</ul>
</div>
</div>
</div>
</section>

<!-- Coluna direita: imagem -->
<aside class="image-header-container">
<img src="../imagens/imagem-info-home.svg" alt="Imagem ilustrativa de emergência" class="image-header">
</aside>
</div>
</div>
</div>


